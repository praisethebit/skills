{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/git-via-ship.sh"
          },
          {
            "type": "command",
            "command": "~/.claude/hooks/bash-write-guard.sh"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/worktree-link.sh"
          }
        ]
      }
    ]
  }
}
